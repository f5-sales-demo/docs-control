{
  "schema_version": 2,
  "defaults": {
    "replicas": 1,
    "profile": "ubuntu-24.04"
  },
  "profiles": {
    "ubuntu-24.04": {
      "image": "ghcr.io/f5-sales-demo/actions-runner@sha256:2ea24045b60fc684f13cccfcc84743ce06e46de9bfd3737eb3a093f497b4dd73",
      "labels": ["ubuntu-24.04"],
      "memory": "8g",
      "cpus": "4",
      "pids_limit": 4096,
      "container_socket": false
    },
    "ubuntu-22.04": {
      "image": "ghcr.io/f5-sales-demo/actions-runner@sha256:c5ea10ad745032a161b025b202dfef71c80e02e17971011f695a7208b9d1e5cc",
      "labels": ["ubuntu-22.04"],
      "memory": "8g",
      "cpus": "4",
      "pids_limit": 4096,
      "container_socket": false
    },
    "container-build": {
      "image": "ghcr.io/f5-sales-demo/actions-runner-container@sha256:242fe51aeaf119a6965635b79d85c1525f46fbe0bb8ec54ad3a8df13e7dfd4a5",
      "labels": ["container-build"],
      "memory": "16g",
      "cpus": "6",
      "pids_limit": 8192,
      "container_socket": true
    }
  },
  "hosted_exceptions": {
    "f5-sales-demo/devcontainer": {
      ".github/workflows/docker-publish.yml": {
        "build-arm64": {
          "runs_on": "ubuntu-24.04-arm",
          "reason": "native ARM64 image build"
        },
        "smoke-test-arm64": {
          "runs_on": "ubuntu-24.04-arm",
          "reason": "native ARM64 smoke test"
        }
      }
    },
    "f5-sales-demo/vscode-xcsh": {
      ".github/workflows/ci.yml": {
        "test-macos": {
          "runs_on": "macos-latest",
          "reason": "native macOS extension test"
        },
        "test-windows": {
          "runs_on": "windows-latest",
          "reason": "native Windows extension test"
        }
      }
    },
    "f5-sales-demo/xcsh": {
      ".github/workflows/ci.yml": {
        "setup-zig-native": {
          "runs_on": "matrix",
          "reason": "native macOS and Windows toolchain validation"
        },
        "native-nonlinux": {
          "runs_on": "matrix",
          "reason": "native macOS and Windows release validation"
        },
        "build-sign-macos": {
          "runs_on": "matrix",
          "reason": "Apple signing and notarization require macOS"
        },
        "verify-homebrew-install": {
          "runs_on": "macos-14",
          "reason": "Homebrew release verification requires macOS"
        }
      },
      ".github/workflows/container.yml": {
        "container-build-arm64": {
          "runs_on": "ubuntu-24.04-arm",
          "reason": "native ARM64 container validation"
        }
      },
      ".github/workflows/test-codesign.yml": {
        "test-codesign": {
          "runs_on": "matrix",
          "reason": "Apple code signing requires native macOS"
        }
      }
    },
    "f5-sales-demo/xcsh-action": {
      ".github/workflows/ci.yml": {
        "test-native": {
          "runs_on": "matrix",
          "reason": "action behavior must be validated on macOS and Windows"
        },
        "validate-native": {
          "runs_on": "matrix",
          "reason": "manifest validation covers native macOS, Windows, and ARM64"
        }
      }
    }
  },
  "repositories": {
    "f5-sales-demo/administration": {},
    "f5-sales-demo/api-protection": {},
    "f5-sales-demo/api-specs": {},
    "f5-sales-demo/api-specs-enriched": {},
    "f5-sales-demo/apt-repo": {},
    "f5-sales-demo/bot-advanced": {},
    "f5-sales-demo/bot-standard": {},
    "f5-sales-demo/cdn": {},
    "f5-sales-demo/cdn-simulator": {},
    "f5-sales-demo/console": {},
    "f5-sales-demo/csd": {},
    "f5-sales-demo/ddos": {},
    "f5-sales-demo/demo-resource-template": {},
    "f5-sales-demo/demo-resources": {},
    "f5-sales-demo/devcontainer": {
      "runner": {
        "profiles": ["ubuntu-24.04", "container-build"]
      }
    },
    "f5-sales-demo/dns": {},
    "f5-sales-demo/docs": {},
    "f5-sales-demo/docs-builder": {
      "runner": {
        "profiles": ["ubuntu-24.04", "container-build"]
      }
    },
    "f5-sales-demo/docs-control": {
      "runner": {
        "profiles": ["ubuntu-24.04", "container-build"]
      }
    },
    "f5-sales-demo/docs-icons": {},
    "f5-sales-demo/docs-theme": {},
    "f5-sales-demo/i18n-core": {},
    "f5-sales-demo/marketplace": {},
    "f5-sales-demo/marketplace-claude-code": {},
    "f5-sales-demo/mcn": {},
    "f5-sales-demo/nginx": {},
    "f5-sales-demo/observability": {},
    "f5-sales-demo/origin-server": {},
    "f5-sales-demo/starlight-llms-txt": {},
    "f5-sales-demo/starlight-mega-menu": {},
    "f5-sales-demo/traffic-generator": {},
    "f5-sales-demo/vscode-xcsh": {},
    "f5-sales-demo/waf": {},
    "f5-sales-demo/was": {},
    "f5-sales-demo/webapp-api-protection": {},
    "f5-sales-demo/xcsh": {
      "runner": {
        "profiles": ["ubuntu-24.04", "ubuntu-22.04", "container-build"]
      }
    },
    "f5-sales-demo/xcsh-action": {},
    "f5-sales-demo/xcsh-chrome-extension": {},
    "f5-sales-demo/terraform-provider-xcsh": {
      ".github/workflows/acc-tests.yml": {
        "real-api-tests": {
          "runs_on": ["self-hosted", "Linux", "X64", "terraform-provider-xcsh", "ubuntu-24.04"],
          "environment": "acceptance-tests",
          "permissions": {
            "checks": "write",
            "contents": "read"
          },
          "allowed_secrets": ["XCSH_API_TOKEN", "XCSH_API_URL"],
          "triggers": {
            "pull_request": {
              "branches": ["main"],
              "paths": [
                "internal/provider/**",
                "internal/client/**",
                "internal/acctest/**",
                "internal/functions/**",
                "internal/blindfold/**"
              ]
            },
            "schedule": [
              {
                "cron": "0 2 * * 1"
              }
            ],
            "workflow_dispatch": {
              "inputs": {
                "mode": {
                  "default": "full",
                  "description": "Test mode",
                  "options": ["mock-only", "real-only", "full", "pr-subset"],
                  "required": true,
                  "type": "choice"
                },
                "parallel": {
                  "default": "4",
                  "description": "Parallelism for mock tests",
                  "required": false,
                  "type": "string"
                },
                "timeout": {
                  "default": "10",
                  "description": "Timeout per test (minutes)",
                  "required": false,
                  "type": "string"
                }
              }
            }
          },
          "if": "always() &&\ngithub.event_name != 'pull_request' &&\n((github.event_name == 'schedule' &&\n  needs.mock-tests.result == 'success') ||\n (github.event_name == 'workflow_dispatch' &&\n  github.event.inputs.mode == 'full' &&\n  needs.mock-tests.result == 'success') ||\n (github.event_name == 'workflow_dispatch' &&\n  github.event.inputs.mode == 'real-only' &&\n  needs.mock-tests.result == 'skipped'))\n"
        },
        "cleanup": {
          "runs_on": ["self-hosted", "Linux", "X64", "terraform-provider-xcsh", "ubuntu-24.04"],
          "environment": "acceptance-tests",
          "permissions": {
            "contents": "read"
          },
          "allowed_secrets": ["XCSH_API_TOKEN", "XCSH_API_URL"],
          "triggers": {
            "pull_request": {
              "branches": ["main"],
              "paths": [
                "internal/provider/**",
                "internal/client/**",
                "internal/acctest/**",
                "internal/functions/**",
                "internal/blindfold/**"
              ]
            },
            "schedule": [
              {
                "cron": "0 2 * * 1"
              }
            ],
            "workflow_dispatch": {
              "inputs": {
                "mode": {
                  "default": "full",
                  "description": "Test mode",
                  "options": ["mock-only", "real-only", "full", "pr-subset"],
                  "required": true,
                  "type": "choice"
                },
                "parallel": {
                  "default": "4",
                  "description": "Parallelism for mock tests",
                  "required": false,
                  "type": "string"
                },
                "timeout": {
                  "default": "10",
                  "description": "Timeout per test (minutes)",
                  "required": false,
                  "type": "string"
                }
              }
            }
          },
          "if": "always() &&\ngithub.event_name != 'pull_request' &&\nneeds.real-api-tests.result != 'skipped'\n"
        }
      },
      ".github/workflows/discover-defaults.yml": {
        "discover": {
          "runs_on": ["self-hosted", "Linux", "X64", "terraform-provider-xcsh", "ubuntu-24.04"],
          "environment": "default-discovery",
          "permissions": {},
          "allowed_secrets": ["REPO_SYNC_TOKEN", "XCSH_API_TOKEN", "XCSH_API_URL"],
          "triggers": {
            "schedule": [
              {
                "cron": "0 6 1 * *"
              }
            ],
            "workflow_dispatch": {
              "inputs": {
                "dry_run": {
                  "default": false,
                  "description": "Dry run (no PR creation)",
                  "required": false,
                  "type": "boolean"
                },
                "mode": {
                  "default": "discover",
                  "description": "Discovery mode",
                  "options": ["discover", "validate", "single"],
                  "required": true,
                  "type": "choice"
                },
                "resource": {
                  "default": "",
                  "description": "Resource name (for single mode only)",
                  "required": false,
                  "type": "string"
                }
              }
            }
          },
          "if": null
        }
      }
    }
  }
}
